{
  "name": "trustchain",
  "version": "1.0.0",
  "private": true,
  "description": "Blockchain Digital Certificate Verification + Supply Chain + NFT Marketplace + DeFi + DAO platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "blockchain": "hardhat node",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy": "hardhat run scripts/deploy.ts --network localhost",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "ts-node scripts/seed.ts",
    "setup": "npm run db:generate && npm run db:push && npm run contracts:compile"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@prisma/client": "^5.14.0",
    "clsx": "^2.1.1",
    "ethers": "^6.12.1",
    "lucide-react": "^0.378.0",
    "next": "^14.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "hardhat": "^2.22.4",
    "postcss": "^8.4.38",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}

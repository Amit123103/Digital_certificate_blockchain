# Database URL (SQLite default for zero-config local run, or PostgreSQL string)
DATABASE_URL="file:./dev.db"

# Local RPC URL
NEXT_PUBLIC_RPC_URL="http://127.0.0.1:8545"
RPC_URL="http://127.0.0.1:8545"

# Chain ID (31337 for Hardhat Localhost)
NEXT_PUBLIC_CHAIN_ID=31337

# Private key for contract deployment (Hardhat Account #0 default)
PRIVATE_KEY="0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"

# Contract Addresses (populated automatically by deploy / seed script)
NEXT_PUBLIC_CONTRACT_CERTIFICATE_REGISTRY=""
NEXT_PUBLIC_CONTRACT_PRODUCT_REGISTRY=""
NEXT_PUBLIC_CONTRACT_SUPPLY_CHAIN=""
NEXT_PUBLIC_CONTRACT_PRODUCT_NFT=""
NEXT_PUBLIC_CONTRACT_MARKETPLACE=""
NEXT_PUBLIC_CONTRACT_MOCK_USD=""
NEXT_PUBLIC_CONTRACT_LENDING_POOL=""
NEXT_PUBLIC_CONTRACT_GOVERNANCE_TOKEN=""
NEXT_PUBLIC_CONTRACT_DAO=""

# IPFS settings
IPFS_API_KEY="mock_ipfs_key"
IPFS_API_SECRET="mock_ipfs_secret"
